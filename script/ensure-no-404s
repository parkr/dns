#!/bin/bash

set -e
set -o pipefail

TEMPORARY_ALLOWLIST='^(ping)\.'

# Hosts that answer 401/403 to anyone outside my networks (or have no page at /),
# so a fetch from CI can never succeed.
RESTRICTED_HOSTS='^(thepod|vault|klaud|radar|visuals)\.parkermakes\.tools$'

python3 script/list-domains.py | \
  egrep '^(CNAME|ALIAS|A)' | egrep -v '10\.0\.1' | egrep -v '(baymax|delwyn)\.' | egrep -v '\.ts\.net$' | \
  awk '{print $2}' | sort | uniq | \
  egrep -v '^(imap|smtp|pop|webmail|email|\*)\.' | \
  egrep -v "$TEMPORARY_ALLOWLIST" | \
  egrep -v "$RESTRICTED_HOSTS" | \
  xargs -n 1 -t -I{} \
    curl --fail --no-progress-meter --output /dev/null https://{}
