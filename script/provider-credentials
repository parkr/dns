#!/bin/sh

. script/use-nix

ZONES=""
ZONES="${ZONES} byparker.com"
ZONES="${ZONES} keltermoore.com"
ZONES="${ZONES} parkermakes.tools"
ZONES="${ZONES} parkermoo.re"
ZONES="${ZONES} parkermoore.de"

# Already-set values (e.g. CI secrets) win over the local files.
export CLOUDFLARE_TOKEN="${CLOUDFLARE_TOKEN:-$(cat ~/.config/cloudflare/parker-token)}"
export CLOUDFLARE_EMAIL="${CLOUDFLARE_EMAIL:-$(cat ~/.config/cloudflare/parker-email)}"
